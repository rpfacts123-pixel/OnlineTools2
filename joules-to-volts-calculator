<script>
(function(){
  var method = document.getElementById('method');
  var energy = document.getElementById('energy');
  var charge = document.getElementById('charge');
  var cap = document.getElementById('cap');
  var chargeGroup = document.getElementById('charge-group');
  var capGroup = document.getElementById('cap-group');
  var btn = document.getElementById('calc-btn');
  var result = document.getElementById('result');

  method.addEventListener('change', function(){
    if (method.value === 'charge') {
      chargeGroup.style.display = 'block';
      capGroup.style.display = 'none';
    } else {
      chargeGroup.style.display = 'none';
      capGroup.style.display = 'block';
    }
    result.classList.remove('show');
  });

  btn.addEventListener('click', function(){
    var e = parseFloat(energy.value);
    if (isNaN(e) || e <= 0) {
      result.textContent = 'Please enter a valid energy value greater than zero.';
      result.classList.add('show');
      return;
    }

    var v;
    if (method.value === 'charge') {
      var q = parseFloat(charge.value);
      if (isNaN(q) || q <= 0) {
        result.textContent = 'Please enter a valid charge value greater than zero.';
        result.classList.add('show');
        return;
      }
      v = e / q;
      result.innerHTML = e + ' joules ÷ ' + q + ' coulombs = <strong>' + v.toFixed(2) + ' volts</strong>';
    } else {
      var c = parseFloat(cap.value);
      if (isNaN(c) || c <= 0) {
        result.textContent = 'Please enter a valid capacitance value greater than zero.';
        result.classList.add('show');
        return;
      }
      v = Math.sqrt((2 * e) / c);
      result.innerHTML = '√(2 × ' + e + ' J ÷ ' + c + ' F) = <strong>' + v.toFixed(2) + ' volts</strong>';
    }
    result.classList.add('show');
  });
})();
</script>

