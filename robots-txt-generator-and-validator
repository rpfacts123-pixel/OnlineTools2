  <script>
    (() => {
      "use strict";

      const $ = (id) => document.getElementById(id);

      const MAX_AGENTS_PER_GROUP = 20;
      const MAX_GROUPS = 30;
      const MAX_RULES_PER_GROUP = 50;

      const els = {
        tabBuild: $("tabBuild"),
        tabValidate: $("tabValidate"),
        panelBuild: $("panelBuild"),
        panelValidate: $("panelValidate"),
        builderGroups: $("builderGroups"),
        addGroup: $("addGroup"),
        sitemapInput: $("sitemapInput"),
        generateBtn: $("generateBtn"),
        copyBtn: $("copyBtn"),
        downloadBtn: $("downloadBtn"),
        buildStatus: $("buildStatus"),
        robotsOutput: $("robotsOutput"),
        validateInput: $("validateInput"),
        validateBtn: $("validateBtn"),
        clearValidate: $("clearValidate"),
        validateStatus: $("validateStatus"),
        issuesList: $("issuesList"),
        validateSummary: $("validateSummary"),
        testUrl: $("testUrl"),
        testAgent: $("testAgent"),
        testBtn: $("testBtn"),
        testResult: $("testResult")
      };

      const state = {
        mode: "build",
        groups: [],
        sitemaps: [],
        generatedText: "",
        validated: null,
        nextGroupId: 1
      };

      /* ---------- Utilities ---------- */

      function setStatus(node, message, type) {
        node.textContent = message;
        node.classList.toggle("is-ok", type === "ok");
        node.classList.toggle("is-error", type === "error");
      }

      function normalizePath(input) {
        let value = String(input || "").trim();
        if (!value) return "";
        if (/^https?:\/\//i.test(value)) {
          try {
            const url = new URL(value);
            return url.pathname + url.search;
          } catch (error) {
            return value;
          }
        }
        if (!value.startsWith("/")) value = "/" + value;
        return value;
      }

      function patternToRegex(pattern) {
        const endsWithDollar = pattern.endsWith("$");
        let body = endsWithDollar ? pattern.slice(0, -1) : pattern;
        body = body.replace(/[.+?^${}()|[\]\\]/g, "\\$&");
        body = body.replace(/\*/g, ".*");
        return new RegExp("^" + body + (endsWithDollar ? "$" : ".*"));
      }

      function ruleMatches(pattern, path) {
        if (!pattern) return false;
        try {
          return patternToRegex(pattern).test(path);
        } catch (error) {
          return false;
        }
      }

      /* ---------- Builder ---------- */

      function makeGroup() {
        const id = state.nextGroupId++;
        return {
          id,
          agents: ["*"],
          rules: [{ type: "disallow", path: "" }]
        };
      }

      function setGroups(groups) {
        state.groups = groups;
        state.nextGroupId = groups.reduce((max, group) => Math.max(max, group.id), 0) + 1;
        renderBuilder();
      }

      function renderBuilder() {
        els.builderGroups.replaceChildren();

        if (state.groups.length === 0) {
          const empty = document.createElement("p");
          empty.className = "hint";
          empty.textContent = "No groups yet. Add a group or choose a preset.";
          els.builderGroups.appendChild(empty);
          return;
        }

        state.groups.forEach((group) => {
          els.builderGroups.appendChild(buildGroupElement(group));
        });
      }

      function buildGroupElement(group) {
        const wrapper = document.createElement("section");
        wrapper.className = "rob-group";
        wrapper.dataset.groupId = String(group.id);

        const head = document.createElement("div");
        head.className = "rob-group-head";

        const agentField = document.createElement("div");
        agentField.className = "rob-field";

        const agentLabel = document.createElement("label");
        agentLabel.textContent = "User-agent (comma-separated)";
        agentLabel.setAttribute("for", "agent-" + group.id);

        const agentInput = document.createElement("input");
        agentInput.id = "agent-" + group.id;
        agentInput.type = "text";
        agentInput.value = group.agents.join(", ");
        agentInput.setAttribute("autocomplete", "off");
        agentInput.setAttribute("spellcheck", "false");
        agentInput.setAttribute("list", "agentList");

        agentInput.addEventListener("input", () => {
          group.agents = agentInput.value
            .split(",")
            .map((value) => value.trim())
            .filter(Boolean)
            .slice(0, MAX_AGENTS_PER_GROUP);

          if (group.agents.length === 0) {
            group.agents = ["*"];
          }
        });

        agentField.append(agentLabel, agentInput);

        const removeGroup = document.createElement("button");
        removeGroup.type = "button";
        removeGroup.className = "btn btn-sm btn-ghost";
        removeGroup.textContent = "Remove group";
        removeGroup.addEventListener("click", () => {
          state.groups = state.groups.filter((item) => item.id !== group.id);
          renderBuilder();
        });

        head.append(agentField, removeGroup);
        wrapper.appendChild(head);

        const rulesWrap = document.createElement("div");
        rulesWrap.className = "rob-rules";

        group.rules.forEach((rule, index) => {
          rulesWrap.appendChild(buildRuleElement(group, rule, index));
        });

        wrapper.appendChild(rulesWrap);

        const addRule = document.createElement("button");
        addRule.type = "button";
        addRule.className = "btn btn-sm btn-secondary";
        addRule.textContent = "Add rule";
        addRule.addEventListener("click", () => {
          if (group.rules.length >= MAX_RULES_PER_GROUP) return;
          group.rules.push({ type: "disallow", path: "" });
          renderBuilder();
        });

        wrapper.appendChild(addRule);
        return wrapper;
      }

      function buildRuleElement(group, rule, index) {
        const row = document.createElement("div");
        row.className = "rob-rule";

        const typeSelect = document.createElement("select");
        typeSelect.setAttribute("aria-label", "Rule type");
        ["allow", "disallow"].forEach((type) => {
          const option = document.createElement("option");
          option.value = type;
          option.textContent = type === "allow" ? "Allow" : "Disallow";
          if (rule.type === type) option.selected = true;
          typeSelect.appendChild(option);
        });
        typeSelect.addEventListener("change", () => {
          rule.type = typeSelect.value;
        });

        const pathInput = document.createElement("input");
        pathInput.type = "text";
        pathInput.value = rule.path;
        pathInput.placeholder = "/path/ or /*.pdf$";
        pathInput.setAttribute("aria-label", "Path");
        pathInput.setAttribute("autocomplete", "off");
        pathInput.setAttribute("spellcheck", "false");
        pathInput.addEventListener("input", () => {
          rule.path = pathInput.value;
        });

        const removeRule = document.createElement("button");
        removeRule.type = "button";
        removeRule.className = "btn btn-sm btn-ghost";
        removeRule.textContent = "Remove";
        removeRule.setAttribute("aria-label", "Remove this rule");
        removeRule.addEventListener("click", () => {
          group.rules.splice(index, 1);
          if (group.rules.length === 0) {
            group.rules.push({ type: "disallow", path: "" });
          }
          renderBuilder();
        });

        row.append(typeSelect, pathInput, removeRule);
        return row;
      }

      function generateText() {
        const lines = [];
        const warnings = [];

        state.groups.forEach((group) => {
          const agents = group.agents.length ? group.agents : ["*"];
          const validRules = group.rules.filter((rule) => rule.path.trim());

          if (validRules.length === 0) {
            warnings.push("A group with user-agent \"" + agents.join(", ") + "\" has no rules. It will be skipped.");
            return;
          }

          agents.forEach((agent) => {
            lines.push("User-agent: " + agent);
          });

          validRules.forEach((rule) => {
            const path = rule.path.trim();
            lines.push((rule.type === "allow" ? "Allow: " : "Disallow: ") + path);
          });

          lines.push("");
        });

        const sitemap = els.sitemapInput.value.trim();
        if (sitemap) {
          if (!/^https?:\/\//i.test(sitemap)) {
            warnings.push("The sitemap URL should start with https:// or http://.");
          } else {
            lines.push("Sitemap: " + sitemap);
          }
        }

        return {
          text: lines.join("\n").trim(),
          warnings
        };
      }

      function handleGenerate() {
        if (state.groups.length === 0) {
          setStatus(els.buildStatus, "Add at least one group before generating.", "error");
          return;
        }

        const result = generateText();

        if (!result.text) {
          setStatus(els.buildStatus, "No rules to generate. Add a path to at least one rule.", "error");
          return;
        }

        state.generatedText = result.text;
        els.robotsOutput.textContent = result.text;
        els.copyBtn.disabled = false;
        els.downloadBtn.disabled = false;

        if (result.warnings.length) {
          setStatus(els.buildStatus, "Generated with warnings: " + result.warnings.join(" "), "error");
        } else {
          setStatus(els.buildStatus, "Generated. " + countGroups(result.text) + " groups, " + countRules(result.text) + " rules.", "ok");
        }
      }

      function countGroups(text) {
        return (text.match(/^User-agent:/gm) || []).length;
      }

      function countRules(text) {
        return (text.match(/^(Allow|Disallow):/gm) || []).length;
      }

      /* ---------- Presets ---------- */

      function applyPreset(name) {
        const groups = [];

        if (name === "allow") {
          groups.push({
            id: state.nextGroupId++,
            agents: ["*"],
            rules: [{ type: "allow", path: "/" }]
          });
          els.sitemapInput.value = "";
        } else if (name === "block") {
          groups.push({
            id: state.nextGroupId++,
            agents: ["*"],
            rules: [{ type: "disallow", path: "/" }]
          });
          els.sitemapInput.value = "";
        } else if (name === "standard") {
          groups.push({
            id: state.nextGroupId++,
            agents: ["*"],
            rules: [
              { type: "allow", path: "/" },
              { type: "disallow", path: "/admin/" },
              { type: "disallow", path: "/api/" },
              { type: "disallow", path: "/cart/" },
              { type: "disallow", path: "/checkout/" },
              { type: "disallow", path: "/search" }
            ]
          });
        } else if (name === "ai") {
          groups.push({
            id: state.nextGroupId++,
            agents: ["*"],
            rules: [{ type: "allow", path: "/" }]
          });
          ["GPTBot", "ClaudeBot", "CCBot", "Bytespider", "Google-Extended"].forEach((agent) => {
            groups.push({
              id: state.nextGroupId++,
              agents: [agent],
              rules: [{ type: "disallow", path: "/" }]
            });
          });
        }

        setGroups(groups);
        setStatus(els.buildStatus, "Preset applied. Adjust the rules and click Generate.", "");
      }

      /* ---------- Validator ---------- */

      function parseRobotsTxt(text) {
        const lines = String(text).split(/\r?\n/);
        const groups = [];
        const sitemaps = [];
        const errors = [];
        const warnings = [];

        let currentGroup = null;

        lines.forEach((rawLine, index) => {
          const lineNumber = index + 1;
          const hashIndex = rawLine.indexOf("#");
          const line = hashIndex >= 0 ? rawLine.slice(0, hashIndex) : rawLine;
          const trimmed = line.trim();

          if (!trimmed) return;

          const colonIndex = trimmed.indexOf(":");
          if (colonIndex < 0) {
            errors.push({
              line: lineNumber,
              message: "Line is missing a colon. Every directive needs the form Name: value."
            });
            return;
          }

          const field = trimmed.slice(0, colonIndex).trim().toLowerCase();
          const value = trimmed.slice(colonIndex + 1).trim();

          if (field === "user-agent") {
            if (!value) {
              errors.push({ line: lineNumber, message: "User-agent line has no value." });
              return;
            }

            if (currentGroup && currentGroup.hasRules) {
              currentGroup = { agents: [value], rules: [], line: lineNumber, hasRules: false };
              groups.push(currentGroup);
            } else if (currentGroup) {
              currentGroup.agents.push(value);
            } else {
              currentGroup = { agents: [value], rules: [], line: lineNumber, hasRules: false };
              groups.push(currentGroup);
            }
            return;
          }

          if (field === "allow" || field === "disallow") {
            if (!currentGroup) {
              errors.push({
                line: lineNumber,
                message: "\"" + field + "\" appears before any User-agent line, so it has no group to belong to."
              });
              return;
            }

            if (value && !value.startsWith("/")) {
              warnings.push({
                line: lineNumber,
                message: "The path \"" + value + "\" does not start with /. Most crawlers expect paths to be root-relative."
              });
            }

            currentGroup.rules.push({ type: field, path: value, line: lineNumber });
            currentGroup.hasRules = true;
            return;
          }

          if (field === "sitemap") {
            if (!/^https?:\/\//i.test(value)) {
              errors.push({
                line: lineNumber,
                message: "Sitemap must be an absolute URL starting with http:// or https://."
              });
            } else {
              sitemaps.push(value);
            }
            return;
          }

          if (field === "crawl-delay") {
            warnings.push({
              line: lineNumber,
              message: "Crawl-delay is not supported by Google. Bing reads it. It has no effect on Googlebot."
            });
            return;
          }

          if (field === "host") {
            warnings.push({
              line: lineNumber,
              message: "Host is a Yandex-specific directive. Google and Bing ignore it."
            });
            return;
          }

          warnings.push({
            line: lineNumber,
            message: "Unknown directive \"" + field + "\". It will be ignored by most crawlers."
          });
        });

        groups.forEach((group) => {
          if (group.rules.length === 0) {
            warnings.push({
              line: group.line,
              message: "User-agent \"" + group.agents.join(", ") + "\" has no Allow or Disallow rules."
            });
          }
        });

        return { groups, sitemaps, errors, warnings };
      }

      function renderValidation(result) {
        els.issuesList.replaceChildren();

        result.errors.forEach((issue) => {
          els.issuesList.appendChild(buildIssue("error", issue));
        });

        result.warnings.forEach((issue) => {
          els.issuesList.appendChild(buildIssue("warning", issue));
        });

        const summaryParts = [
          result.groups.length + " group" + (result.groups.length === 1 ? "" : "s"),
          result.groups.reduce((sum, group) => sum + group.rules.length, 0) + " rules",
          result.sitemaps.length + " sitemap" + (result.sitemaps.length === 1 ? "" : "s")
        ];

        els.validateSummary.textContent = summaryParts.join(" · ");

        if (result.errors.length) {
          setStatus(els.validateStatus, result.errors.length + " error" + (result.errors.length === 1 ? "" : "s") + " found. Fix those first.", "error");
        } else if (result.warnings.length) {
          setStatus(els.validateStatus, "Valid, with " + result.warnings.length + " warning" + (result.warnings.length === 1 ? "" : "s") + ".", "ok");
        } else {
          setStatus(els.validateStatus, "Valid. No errors or warnings.", "ok");
        }
      }

      function buildIssue(level, issue) {
        const item = document.createElement("li");
        item.className = "rob-issue rob-issue--" + level;

        if (issue.line) {
          const line = document.createElement("span");
          line.className = "rob-issue-line";
          line.textContent = "Line " + issue.line + ": ";
          item.appendChild(line);
        }

        item.appendChild(document.createTextNode(issue.message));
        return item;
      }

      function handleValidate() {
        const text = els.validateInput.value;

        if (!text.trim()) {
          setStatus(els.validateStatus, "Paste a robots.txt file first.", "error");
          return;
        }

        const result = parseRobotsTxt(text);
        state.validated = result;
        renderValidation(result);
      }

      /* ---------- URL tester ---------- */

      function findMatchingGroups(groups, userAgent) {
        const agent = String(userAgent || "*").trim().toLowerCase();
        const exact = [];
        const wildcard = [];

        groups.forEach((group) => {
          group.agents.forEach((value) => {
            const lower = value.toLowerCase();
            if (lower === agent) exact.push(group);
            else if (lower === "*") wildcard.push(group);
          });
        });

        return exact.length ? exact : wildcard;
      }

      function evaluatePath(groups, userAgent, path) {
        const matching = findMatchingGroups(groups, userAgent);

        if (matching.length === 0) {
          return { allowed: true, rule: null, reason: "No group matches this user agent, so the default is to allow." };
        }

        let best = null;

        matching.forEach((group) => {
          group.rules.forEach((rule) => {
            if (!rule.path) return;
            if (!ruleMatches(rule.path, path)) return;

            const length = rule.path.length;

            if (!best || length > best.length ||
                (length === best.length && rule.type === "allow" && best.type !== "allow")) {
              best = { type: rule.type, path: rule.path, length, line: rule.line };
            }
          });
        });

        if (!best) {
          return { allowed: true, rule: null, reason: "No rule matches this path, so the default is to allow." };
        }

        return {
          allowed: best.type === "allow",
          rule: best,
          reason: "The longest matching rule is \"" + best.type + ": " + best.path + "\"."
        };
      }

      function handleTest() {
        const rawUrl = els.testUrl.value.trim();
        const agent = els.testAgent.value.trim() || "*";

        if (!rawUrl) {
          els.testResult.className = "rob-tester-result is-idle";
          els.testResult.textContent = "Enter a URL or path to test.";
          return;
        }

        const path = normalizePath(rawUrl);

        if (!path) {
          els.testResult.className = "rob-tester-result is-idle";
          els.testResult.textContent = "The URL could not be parsed. Try a path like /admin/.";
          return;
        }

        let groups = [];

        if (state.mode === "validate" && state.validated) {
          groups = state.validated.groups;
        } else {
          groups = state.groups;
        }

        if (groups.length === 0) {
          els.testResult.className = "rob-tester-result is-idle";
          els.testResult.textContent = "There are no rules to test yet. Build a file or validate one first.";
          return;
        }

        const result = evaluatePath(groups, agent, path);

        els.testResult.className = "rob-tester-result " + (result.allowed ? "is-allowed" : "is-blocked");
        els.testResult.replaceChildren();

        const headline = document.createElement("strong");
        headline.textContent = result.allowed ? "ALLOWED" : "BLOCKED";
        els.testResult.appendChild(headline);

        const detail = document.createElement("span");
        detail.textContent = " " + agent + " requesting " + path + ". " + result.reason;
        els.testResult.appendChild(detail);
      }

      /* ---------- Clipboard and download ---------- */

      async function copyText(text) {
        if (!text) return false;

        if (navigator.clipboard && window.isSecureContext) {
          try {
            await navigator.clipboard.writeText(text);
            return true;
          } catch (error) {
            // fall through to the fallback
          }
        }

        const textarea = document.createElement("textarea");
        textarea.value = text;
        textarea.readOnly = true;
        textarea.setAttribute("aria-hidden", "true");
        Object.assign(textarea.style, {
          position: "fixed", left: "-9999px", top: "0", opacity: "0"
        });

        document.body.appendChild(textarea);
        textarea.focus();
        textarea.select();

        let copied = false;
        try {
          copied = document.execCommand("copy");
        } catch (error) {
          copied = false;
        } finally {
          textarea.remove();
        }

        return copied;
      }

      function downloadText(text, filename) {
        const blob = new Blob([text], { type: "text/plain;charset=utf-8" });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download = filename;
        link.hidden = true;
        document.body.appendChild(link);

        try {
          link.click();
        } finally {
          link.remove();
          window.setTimeout(() => URL.revokeObjectURL(url), 2000);
        }
      }

      /* ---------- Mode switching ---------- */

      function setMode(mode) {
        state.mode = mode;
        const isBuild = mode === "build";

        els.panelBuild.hidden = !isBuild;
        els.panelValidate.hidden = isBuild;
        els.tabBuild.setAttribute("aria-selected", String(isBuild));
        els.tabValidate.setAttribute("aria-selected", String(!isBuild));
      }

      /* ---------- Events ---------- */

      els.tabBuild.addEventListener("click", () => setMode("build"));
      els.tabValidate.addEventListener("click", () => setMode("validate"));

      els.addGroup.addEventListener("click", () => {
        if (state.groups.length >= MAX_GROUPS) return;
        state.groups.push(makeGroup());
        renderBuilder();
      });

      document.querySelectorAll("[data-preset]").forEach((button) => {
        button.addEventListener("click", () => applyPreset(button.dataset.preset));
      });

      els.generateBtn.addEventListener("click", handleGenerate);

      els.copyBtn.addEventListener("click", async () => {
        const copied = await copyText(state.generatedText);
        setStatus(els.buildStatus, copied ? "Copied to clipboard." : "Copy was blocked. Select the output and copy it manually.", copied ? "ok" : "error");
      });

      els.downloadBtn.addEventListener("click", () => {
        if (!state.generatedText) return;
        downloadText(state.generatedText, "robots.txt");
        setStatus(els.buildStatus, "Download started: robots.txt", "ok");
      });

      els.validateBtn.addEventListener("click", handleValidate);

      els.clearValidate.addEventListener("click", () => {
        els.validateInput.value = "";
        els.issuesList.replaceChildren();
        els.validateSummary.textContent = "";
        state.validated = null;
        setStatus(els.validateStatus, "Cleared. Paste a file to validate.", "");
      });

      els.testBtn.addEventListener("click", handleTest);

      els.testUrl.addEventListener("keydown", (event) => {
        if (event.key === "Enter") {
          event.preventDefault();
          handleTest();
        }
      });

      /* ---------- Init ---------- */

      setGroups([makeGroup()]);
      setMode("build");
      setStatus(els.buildStatus, "Ready. A blank group is loaded. Add rules or choose a preset.", "");
    })();
  </script>
</body>
</html>
